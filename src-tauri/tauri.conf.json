{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vector-watcher",
  "version": "1.1.5",
  "identifier": "com.recursivezero.vectorwatcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vector Watcher",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  }
}
